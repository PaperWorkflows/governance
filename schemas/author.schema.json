{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperfactory:author:1",
  "title": "Author Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "affiliations"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Lowercase identifier used as reference key in paper.yaml authors[].author_id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Full name in native script"
    },
    "name_en": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        { "type": "null" }
      ],
      "description": "Name in English / romanized"
    },
    "affiliations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "email": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "^\\S+@\\S+\\.\\S+$" },
        { "type": "null" }
      ]
    },
    "orcid": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" },
        { "type": "null" }
      ]
    },
    "git_name": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        { "type": "null" }
      ],
      "description": "Git commit identity name (if different from paper name)"
    },
    "git_email": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "^\\S+@\\S+$" },
        { "type": "null" }
      ],
      "description": "Git commit identity email (private noreply preferred)"
    }
  }
}
